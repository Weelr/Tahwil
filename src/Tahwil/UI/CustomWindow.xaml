<Window x:Class="Tahwil.UI.CustomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Title="Tahwil">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <StackPanel>
            <!-- title bar -->
            <Grid Height="40" Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Tahwil-256.png" Width="18" Height="18" />
                    <TextBlock x:Name="WinTitle" Style="{StaticResource SubText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Sub}" />
                </Button>
            </Grid>

            <StackPanel Margin="24,4,24,0">
                <TextBlock x:Name="Heading" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SizeText" Style="{StaticResource SubText}" Margin="0,4,0,0" />

                <TextBlock x:Name="FormatLabel" Style="{StaticResource Label}" Margin="0,20,0,8" />
                <WrapPanel x:Name="Chips" />

                <!-- quality -->
                <StackPanel x:Name="QualityPanel" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock x:Name="QualityLabel" Style="{StaticResource Label}" />
                        <TextBlock x:Name="QualityValue" Style="{StaticResource SubText}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="QualitySlider" Minimum="0" Maximum="100" Value="80" SmallChange="5" LargeChange="10"
                            FlowDirection="LeftToRight" ValueChanged="OnQualityChanged" />
                    <Grid Margin="0,4,0,0" FlowDirection="LeftToRight">
                        <TextBlock x:Name="SmallText" Style="{StaticResource SubText}" FontSize="11.5" HorizontalAlignment="Left" />
                        <TextBlock x:Name="BalancedText" Style="{StaticResource SubText}" FontSize="11.5" HorizontalAlignment="Center" />
                        <TextBlock x:Name="BestText" Style="{StaticResource SubText}" FontSize="11.5" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- image dimensions -->
                <StackPanel x:Name="SizePanel" Margin="0,18,0,0">
                    <TextBlock x:Name="DimLabel" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Field}">
                            <DockPanel>
                                <TextBlock x:Name="WLabel" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <TextBlock Text="px" Style="{StaticResource SubText}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBox x:Name="WBox" TextAlignment="Right" VerticalAlignment="Center" TextChanged="OnWidthChanged" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Field}">
                            <DockPanel>
                                <TextBlock x:Name="HLabel" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <TextBlock Text="px" Style="{StaticResource SubText}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBox x:Name="HBox" TextAlignment="Right" VerticalAlignment="Center" TextChanged="OnHeightChanged" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <CheckBox x:Name="KeepRatio" IsChecked="True" Margin="0,10,0,0" />
                </StackPanel>

                <!-- video resolution -->
                <StackPanel x:Name="ResPanel" Margin="0,18,0,0">
                    <TextBlock x:Name="ResLabel" Style="{StaticResource Label}" />
                    <WrapPanel x:Name="ResChips" />
                </StackPanel>

                <!-- audio bitrate -->
                <StackPanel x:Name="BitratePanel" Margin="0,12,0,0">
                    <TextBlock x:Name="BitrateLabel" Style="{StaticResource Label}" />
                    <WrapPanel x:Name="BitrateChips" />
                </StackPanel>

                <!-- documents -->
                <Border x:Name="NoOptionsPanel" Margin="0,18,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Hover}">
                    <StackPanel>
                        <TextBlock x:Name="NoOptionsText" FontSize="13" />
                        <TextBlock x:Name="EngineText" Style="{StaticResource SubText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- save location -->
                <TextBlock x:Name="SaveLabel" Style="{StaticResource Label}" Margin="0,20,0,8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SaveNext" GroupName="save" IsChecked="True" />
                    <RadioButton x:Name="SaveOther" GroupName="save" Click="OnPickFolder" />
                </StackPanel>
                <TextBlock x:Name="FolderText" Style="{StaticResource SubText}" Margin="26,6,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </StackPanel>

            <Border Margin="0,22,0,0" Padding="24,16" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
                <Grid>
                    <CheckBox x:Name="Remember" IsChecked="True" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True" />
                        <Button x:Name="OkBtn" Style="{StaticResource BtnPrimary}" Click="OnOk" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
