<Window x:Class="Tahwil.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Title="Tahwil">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <StackPanel>
            <Grid Height="40" Margin="16,0,8,0">
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Sub}" />
                </Button>
            </Grid>
            <StackPanel Margin="28,0,28,28" HorizontalAlignment="Center">
                <Image Source="/Assets/Tahwil-256.png" Width="72" Height="72" />
                <TextBlock x:Name="NameText" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="VersionText" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="HintText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
                <Button x:Name="UpdateBtn" Style="{StaticResource Btn}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="OnCheck" />
                <TextBlock x:Name="UpdateText" Style="{StaticResource SubText}" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
